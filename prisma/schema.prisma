// HW888 — Holistic World Sales Platform
// Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProductLevel {
  LEVEL_1X
  LEVEL_2X
  LEVEL_3X
  LEVEL_6X
}

enum PaymentType {
  CASH
  CARD
}

enum EquipmentTaskType {
  TABLES
  CHAIRS
  TENT
  TENT_WEIGHTS
  EXTENSION_CORD
  DISPLAY
}

enum EquipmentStatus {
  PENDING
  COMPLETED
}

enum GroceryStatus {
  PENDING
  PURCHASED
}

enum TripType {
  FLIGHT
  CAR_RENTAL
  HOTEL
  AIRBNB
}

enum TripStatus {
  PENDING
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            Role     @default(EMPLOYEE)
  managerId       String?
  manager         User?    @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees       User[]   @relation("ManagerEmployees")
  isActive        Boolean  @default(true)
  city            String?  // free-text — "Orlando", "LA", etc.
  homeAirportCode String?  // 3-letter IATA — "MCO", "LAX"
  emailDigest     Boolean  @default(true)  // receive daily sales digest
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sales              Sale[]
  showAssignments    ShowAssignment[]
  inventoryItems     InventoryItem[]
  travelTrips        TravelTrip[]
  equipmentTasks      EquipmentTask[]
  equipmentCompleted  EquipmentTask[] @relation("EquipmentCompletedBy")
  groceryItemsAdded  GroceryItem[]   @relation("AddedBy")
  groceryItemsPurchased GroceryItem[] @relation("PurchasedBy")
  managedShows       Show[]            @relation("ManagerShows")
  cashDrawers        CashDrawer[]    @relation("DrawerOpener")
  cashDrawersClosed  CashDrawer[]    @relation("DrawerCloser")
  commissionRate     CommissionRate?
  adjustmentsMade    SaleAdjustment[]      @relation("SaleAdjuster")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjuster")
  ownedCustomers     Customer[]            @relation("CustomerOwner")
  shippingOrders     ShippingOrder[]       @relation("ShippingCreator")

  @@index([managerId])
  @@index([role])
  @@index([city])
  @@index([homeAirportCode])
}

// ─── CommissionRate ──────────────────────────────────────────────────────────

model CommissionRate {
  id            String   @id @default(cuid())
  userId        String   @unique
  baseRate      Float    @default(0.30)   // % on user's own sales
  managerBonus  Float    @default(0.00)   // % bonus on team total at attended shows
  effectiveFrom DateTime @default(now())
  notes         String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Show ─────────────────────────────────────────────────────────────────────

model Show {
  id          String   @id @default(cuid())
  name        String
  location    String
  address     String?
  startDate   DateTime
  endDate     DateTime
  isOutdoor   Boolean  @default(false)
  status      String   @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED | CANCELLED
  notes       String?
  managerId   String?
  manager     User?    @relation("ManagerShows", fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignments     ShowAssignment[]
  sales           Sale[]
  cashDrawers     CashDrawer[]
  inventoryItems  InventoryItem[]
  travelTrips     TravelTrip[]
  equipmentTasks  EquipmentTask[]
  groceryItems    GroceryItem[]
  flightOptions   FlightOption[]

  @@index([managerId])
  @@index([startDate])
}

// ─── Show Assignment ───────────────────────────────────────────────────────────

model ShowAssignment {
  id         String   @id @default(cuid())
  showId     String
  userId     String
  assignedAt DateTime @default(now())

  show         Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([showId, userId])
  @@index([userId])
}

// ─── Cash Drawer ─────────────────────────────────────────────────────────────

model CashDrawer {
  id              String    @id @default(cuid())
  showId          String
  openedById      String
  closedById      String?
  openingFloat    Float     @default(0)
  totalCash       Float     @default(0)
  totalCard       Float     @default(0)
  closingBalance  Float?
  countedCash     Float?     // cash physically counted at close-out
  countedCard     Float?     // card receipts total at close-out
  discrepancyCash Float?     // countedCash - (openingFloat + totalCash)
  discrepancyCard Float?     // countedCard - totalCard
  closeNotes      String?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  isActive        Boolean   @default(true)

  show      Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  openedBy  User @relation("DrawerOpener", fields: [openedById], references: [id])
  closedBy  User? @relation("DrawerCloser", fields: [closedById], references: [id])

  @@index([showId])
  @@index([isActive])
}

// ─── Sale ─────────────────────────────────────────────────────────────────────

model Sale {
  id                     String       @id @default(cuid())
  showId                 String
  userId                 String
  productLevel           ProductLevel
  productModel           String
  productStyle           String
  salePrice              Float
  paymentType            PaymentType
  commission             Float        // commission at time of sale
  commissionRateSnapshot Float        @default(0.30) // rate that was applied (for audit)
  isOffline              Boolean      @default(false)
  offlineSynced          Boolean      @default(false)
  source                 String       @default("pos") // pos | import | adjustment | split
  parentSaleId           String?      // when source = split, points to original
  notes                  String?
  discount               Float        @default(0)   // preset discount ($100/$150) or custom manual
  discountReason         String?      // why discount was applied (preset name or custom note)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
  syncedAt               DateTime?

  show         Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerSale CustomerSale?
  parentSale Sale? @relation("SaleSplit", fields: [parentSaleId], references: [id], onDelete: SetNull)
  childSplits Sale[] @relation("SaleSplit")
  adjustments SaleAdjustment[]

  @@index([showId])
  @@index([userId])
  @@index([createdAt])
  @@index([parentSaleId])
}

model SaleAdjustment {
  id           String   @id @default(cuid())
  saleId       String
  adjustedById String
  field        String   // "salePrice" | "paymentType" | "userId" | "showId" | "deleted" | "created"
  oldValue     String?
  newValue     String?
  reason       String?
  createdAt    DateTime @default(now())

  sale       Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  adjustedBy User @relation("SaleAdjuster", fields: [adjustedById], references: [id])

  @@index([saleId])
  @@index([adjustedById])
}

// ─── Inventory Item ────────────────────────────────────────────────────────────

model InventoryItem {
  id                String       @id @default(cuid())
  showId            String?
  managerId         String
  productLevel      ProductLevel
  productModel      String
  productStyle      String
  quantity          Int          @default(0)
  lowStockThreshold Int          @default(5)
  status            String       @default("OK") // OK | LOW | OUT | DISCONTINUED
  updatedAt         DateTime     @updatedAt

  manager User @relation(fields: [managerId], references: [id], onDelete: Cascade)
  show    Show? @relation(fields: [showId], references: [id], onDelete: SetNull)
  adjustments InventoryAdjustment[]

  @@unique([managerId, productLevel, productModel, productStyle])
  @@index([managerId])
  @@index([status])
}

model InventoryAdjustment {
  id           String   @id @default(cuid())
  inventoryId  String
  adjustedById String
  delta        Int      // positive or negative quantity change
  reason       String   // "sale" | "restock" | "shrinkage" | "manual" | "correction"
  saleId       String?  // when reason = "sale", link to the sale
  notes        String?
  createdAt    DateTime @default(now())

  inventory  InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  adjustedBy User          @relation("InventoryAdjuster", fields: [adjustedById], references: [id])

  @@index([inventoryId])
  @@index([adjustedById])
}

// ─── Travel Trip ───────────────────────────────────────────────────────────────

model TravelTrip {
  id        String     @id @default(cuid())
  userId    String
  showId    String?
  type      TripType
  status    TripStatus @default(PENDING)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show?         @relation(fields: [showId], references: [id], onDelete: SetNull)
  flight      FlightDetail?
  carRental   CarRental?
  accommodation Accommodation?

  @@index([userId])
  @@index([showId])
}

// ─── Flight Detail ─────────────────────────────────────────────────────────────

// Pre-populated by admin or fetched from amadeus/skyscanner integrations.
// FlightOption = "this is roughly what flying Frontier/Southwest/Delta costs to get to this show".
model FlightOption {
  id              String   @id @default(cuid())
  showId          String
  airline         String   // "FRONTIER" | "SOUTHWEST" | "DELTA" | "UNITED" | "AMERICAN" | etc.
  originCity      String   // departure city (e.g. "DFW", "DEN", "LAX")
  destinationCity String   // arrival city (matches show location)
  estimatedCost   Float    // one-way estimate in USD
  durationMinutes Int?     // flight duration
  outboundDate    DateTime // when the outbound would depart
  bookingUrl      String   // deep link to that airline's search
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([airline])
}

model FlightDetail {
  id                String @id @default(cuid())
  tripId            String @unique
  airline           String?
  flightNumber      String?
  departureCity     String?
  arrivalCity       String?
  departureTime     DateTime?
  arrivalTime       DateTime?
  confirmationNumber String?
  returnAirline     String?
  returnFlightNumber String?
  returnDepartureTime DateTime?
  returnArrivalTime DateTime?
  estimatedCost     Float?    // rough estimate, can be overridden
  bookingUrl        String?   // direct link to airline booking
  seatNumber        String?
  notes             String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Car Rental ────────────────────────────────────────────────────────────────

model CarRental {
  id                 String    @id @default(cuid())
  tripId             String    @unique
  company            String?
  pickupLocation     String?
  dropoffLocation    String?
  pickupDate         DateTime?
  dropoffDate        DateTime?
  confirmationNumber String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Accommodation ─────────────────────────────────────────────────────────────

model Accommodation {
  id                 String    @id @default(cuid())
  tripId             String    @unique
  type               String    @default("HOTEL") // HOTEL | AIRBNB
  propertyName       String?
  address            String?
  checkIn            DateTime?
  checkOut           DateTime?
  confirmationNumber String?
  notes              String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Equipment Task ─────────────────────────────────────────────────────────────

model EquipmentTask {
  id          String           @id @default(cuid())
  showId      String
  assignedToId String?
  taskType    EquipmentTaskType
  status      EquipmentStatus  @default(PENDING)
  notes       String?
  completedById String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  show       Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy User? @relation("EquipmentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([showId])
}

// ─── Grocery Item ──────────────────────────────────────────────────────────────

model GroceryItem {
  id           String        @id @default(cuid())
  showId       String
  addedById    String
  item         String
  quantity     String?
  estimatedCost Float?
  status       GroceryStatus @default(PENDING)
  purchasedById String?
  purchasedAt  DateTime?
  createdAt    DateTime      @default(now())

  show       Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  addedBy    User @relation("AddedBy", fields: [addedById], references: [id])
  purchasedBy User? @relation("PurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)

  @@index([showId])
}


// ─── Customer (CRM) ───────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  city        String?
  state       String?
  notes       String?
  tags        String?
  ownerId     String
  source      String   @default("manual")
  totalSpent  Float    @default(0)
  visitCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User           @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sales          CustomerSale[]
  shippingOrders ShippingOrder[]

  @@index([ownerId])
  @@index([email])
  @@index([phone])
  @@index([name])
}

model CustomerSale {
  id         String   @id @default(cuid())
  customerId String
  saleId     String   @unique
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── Shipping Order ────────────────────────────────────────────────────────────

model ShippingOrder {
  id               String         @id @default(cuid())
  trackingNumber   String?        @unique
  carrier          String         @default("USPS")
  status           String         @default("NEW")
  customerId       String?
  recipientName    String
  recipientEmail   String?
  recipientPhone   String?
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  postalCode       String
  country          String         @default("US")
  items            String
  notes            String?
  shippingCost     Float          @default(0)
  createdById      String
  createdAt        DateTime       @default(now())
  shippedAt        DateTime?
  deliveredAt      DateTime?
  updatedAt        DateTime       @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ShippingCreator", fields: [createdById], references: [id])
  events    ShippingEvent[]

  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
}

model ShippingEvent {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  location    String?
  description String
  createdAt   DateTime @default(now())
  createdById String?

  order ShippingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
