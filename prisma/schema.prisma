// HW888 — Holistic World Sales Platform
// Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProductLevel {
  LEVEL_1X
  LEVEL_2X
  LEVEL_3X
  LEVEL_6X
}

enum PaymentType {
  CASH
  CARD
}

enum EquipmentTaskType {
  TABLES
  CHAIRS
  TENT
  TENT_WEIGHTS
  EXTENSION_CORD
  DISPLAY
}

enum EquipmentStatus {
  PENDING
  COMPLETED
}

enum GroceryStatus {
  PENDING
  PURCHASED
}

enum TripType {
  FLIGHT
  CAR_RENTAL
  HOTEL
  AIRBNB
}

enum TripStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  managerId    String?
  manager      User?    @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees    User[]   @relation("ManagerEmployees")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sales              Sale[]
  showAssignments    ShowAssignment[]
  inventoryItems     InventoryItem[]
  travelTrips        TravelTrip[]
  equipmentTasks      EquipmentTask[]
  equipmentCompleted  EquipmentTask[] @relation("EquipmentCompletedBy")
  groceryItemsAdded  GroceryItem[] @relation("AddedBy")
  groceryItemsPurchased GroceryItem[] @relation("PurchasedBy")
  managedShows       Show[]            @relation("ManagerShows")
  cashDrawers        CashDrawer[]

  @@index([managerId])
  @@index([role])
}

// ─── Show ─────────────────────────────────────────────────────────────────────

model Show {
  id          String   @id @default(cuid())
  name        String
  location    String
  address     String?
  startDate   DateTime
  endDate     DateTime
  isOutdoor   Boolean  @default(false)
  status      String   @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED | CANCELLED
  notes       String?
  managerId   String?
  manager     User?    @relation("ManagerShows", fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignments     ShowAssignment[]
  sales           Sale[]
  cashDrawers     CashDrawer[]
  inventoryItems  InventoryItem[]
  travelTrips     TravelTrip[]
  equipmentTasks  EquipmentTask[]
  groceryItems    GroceryItem[]

  @@index([managerId])
  @@index([startDate])
}

// ─── Show Assignment ───────────────────────────────────────────────────────────

model ShowAssignment {
  id         String   @id @default(cuid())
  showId     String
  userId     String
  assignedAt DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([showId, userId])
  @@index([userId])
}

// ─── Cash Drawer ─────────────────────────────────────────────────────────────

model CashDrawer {
  id              String    @id @default(cuid())
  showId          String
  openedById      String
  openingFloat    Float     @default(0)
  totalCash       Float     @default(0)
  totalCard       Float     @default(0)
  closingBalance  Float?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  isActive        Boolean   @default(true)

  show      Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  openedBy  User @relation(fields: [openedById], references: [id])

  @@index([showId])
}

// ─── Sale ─────────────────────────────────────────────────────────────────────

model Sale {
  id             String       @id @default(cuid())
  showId         String
  userId         String
  productLevel   ProductLevel
  productModel   String
  productStyle   String
  salePrice      Float
  paymentType    PaymentType
  commission     Float        // 30% of salePrice
  isOffline      Boolean      @default(false)
  offlineSynced  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  syncedAt       DateTime?

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Inventory Item ────────────────────────────────────────────────────────────

model InventoryItem {
  id                String       @id @default(cuid())
  showId            String?
  managerId         String
  productLevel      ProductLevel
  productModel      String
  productStyle      String
  quantity          Int          @default(0)
  lowStockThreshold Int          @default(5)
  updatedAt         DateTime     @updatedAt

  manager User @relation(fields: [managerId], references: [id], onDelete: Cascade)
  show    Show? @relation(fields: [showId], references: [id], onDelete: SetNull)

  @@unique([managerId, productLevel, productModel, productStyle])
  @@index([managerId])
}

// ─── Travel Trip ───────────────────────────────────────────────────────────────

model TravelTrip {
  id        String     @id @default(cuid())
  userId    String
  showId    String?
  type      TripType
  status    TripStatus @default(PENDING)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show?         @relation(fields: [showId], references: [id], onDelete: SetNull)
  flight      FlightDetail?
  carRental   CarRental?
  accommodation Accommodation?

  @@index([userId])
  @@index([showId])
}

// ─── Flight Detail ─────────────────────────────────────────────────────────────

model FlightDetail {
  id                String @id @default(cuid())
  tripId            String @unique
  airline           String?
  flightNumber      String?
  departureCity     String?
  arrivalCity       String?
  departureTime     DateTime?
  arrivalTime       DateTime?
  confirmationNumber String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Car Rental ────────────────────────────────────────────────────────────────

model CarRental {
  id                 String    @id @default(cuid())
  tripId             String    @unique
  company            String?
  pickupLocation     String?
  dropoffLocation    String?
  pickupDate         DateTime?
  dropoffDate        DateTime?
  confirmationNumber String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Accommodation ─────────────────────────────────────────────────────────────

model Accommodation {
  id                 String    @id @default(cuid())
  tripId             String    @unique
  type               String    @default("HOTEL") // HOTEL | AIRBNB
  propertyName       String?
  address            String?
  checkIn            DateTime?
  checkOut           DateTime?
  confirmationNumber String?
  notes              String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Equipment Task ─────────────────────────────────────────────────────────────

model EquipmentTask {
  id          String           @id @default(cuid())
  showId      String
  assignedToId String?
  taskType    EquipmentTaskType
  status      EquipmentStatus  @default(PENDING)
  notes       String?
  completedById String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  show       Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy User? @relation("EquipmentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([showId])
}

// ─── Grocery Item ──────────────────────────────────────────────────────────────

model GroceryItem {
  id           String        @id @default(cuid())
  showId       String
  addedById    String
  item         String
  quantity     String?
  estimatedCost Float?
  status       GroceryStatus @default(PENDING)
  purchasedById String?
  purchasedAt  DateTime?
  createdAt    DateTime      @default(now())

  show       Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  addedBy    User @relation("AddedBy", fields: [addedById], references: [id])
  purchasedBy User? @relation("PurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)

  @@index([showId])
}
